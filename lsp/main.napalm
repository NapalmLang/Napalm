// Napalm language server entry point. Never print protocol debugging to stdout.
import {readFrame, logError} from "./src/transport";
import {createServerState, handleMessage, reportParseError} from "./src/server";

const state = createServerState();
const traceProtocol = Process.getenv("NAPALM_LSP_TRACE") === "1";
if (traceProtocol) logError("LSP started; waiting for JSON-RPC frames");
try {
    while (true) {
        const frame = readFrame();
        if (frame === null) break;
        if (traceProtocol && frame["parsed"]) logError("JSON-RPC frame received");
        if (!frame["parsed"]) {
            reportParseError();
            continue;
        }
        if (handleMessage(state, frame["message"])) {
            Process.exit(state["shutdown"] ? 0 : 1);
        }
    }
} catch (error) {
    logError("Unhandled LSP failure: " + `${error}`);
    Process.exit(1);
}
Process.exit(state["shutdown"] ? 0 : 1);
