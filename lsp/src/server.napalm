// JSON-RPC 2.0 / LSP 3.17 lifecycle and text-document synchronization.
import {sendFrame, logError} from "./transport";
import {buildModuleIndex, updateModuleIndex, filePathForUri, recordForUri, documentDiagnostics, moduleDefinitionAt, moduleReferencesAt} from "./module_index";
import {completionAt, hoverAt, signatureHelpAt} from "./intelligence";
import {semanticTokensAt, prepareRenameAt, renameAt, SEMANTIC_TOKEN_TYPES, SEMANTIC_TOKEN_MODIFIERS} from "./editor_features";
import {createDocumentStore, openDocument, changeDocument, closeDocument, getDocument} from "./documents";

export function createServerState() {
    return {
        initialized: false,
        shutdown: false,
        documents: createDocumentStore(),
        analyses: new Map(),
        workspaceRoots: [],
        moduleIndex: null,
        indexStats: null
    };
}

function respond(id, result) {
    sendFrame({jsonrpc: "2.0", id: id, result: result});
}

function respondError(id, code, message) {
    sendFrame({jsonrpc: "2.0", id: id, error: {code: code, message: message}});
}

export function reportParseError() {
    respondError(null, -32700, "Parse error");
}

// Rebuild the reachable source graph on changes. Unsaved editor buffers are
// authoritative; dependent open documents receive fresh diagnostics as well.
function refreshModules(state, dirtyPaths) {
    const index = updateModuleIndex(state["moduleIndex"], state["documents"],
        state["workspaceRoots"], dirtyPaths);
    state["moduleIndex"] = index;
    state["indexStats"] = index.stats;
    for (const uri of state["documents"].keys()) {
        const record = recordForUri(index, uri);
        if (record === null) continue;
        const document = getDocument(state["documents"], uri);
        state["analyses"].set(uri, {version: document["version"], result: record.semantic});
        sendFrame({
            jsonrpc: "2.0",
            method: "textDocument/publishDiagnostics",
            params: {uri: uri, version: document["version"], diagnostics: documentDiagnostics(index, uri)}
        });
    }
}

function addRoot(state, uri) {
    if (typeof uri !== "String" || !uri.startsWith("file:")) return;
    try {
        const path = Path.normalize(Uri.toFilePath(uri));
        for (const existing of state["workspaceRoots"]) {
            if (existing === path) return;
        }
        state["workspaceRoots"].push(path);
    } catch (error) { }
}

function initializeWorkspace(state, params) {
    if (!isObjectValue(params)) return;
    const folders = params["workspaceFolders"];
    if (folders !== null) {
        for (const folder of folders) {
            if (isObjectValue(folder)) addRoot(state, folder["uri"]);
        }
    }
    if (state["workspaceRoots"].length === 0) addRoot(state, params["rootUri"]);
    if (state["workspaceRoots"].length === 0 && typeof params["rootPath"] === "String") {
        state["workspaceRoots"].push(Path.normalize(params["rootPath"]));
    }
}

function clearLexicalDiagnostics(uri) {
    sendFrame({
        jsonrpc: "2.0",
        method: "textDocument/publishDiagnostics",
        params: {uri: uri, diagnostics: []}
    });
}

function isObjectValue(value) {
    if (value === null) return false;
    const kind = typeof value;
    return kind === "Object" || kind === "Map";
}

function validLspPosition(position) {
    return isObjectValue(position) &&
        typeof position["line"] === "Number" && position["line"].isInteger &&
        typeof position["character"] === "Number" && position["character"].isInteger &&
        position["line"] >= 0 && position["character"] >= 0;
}

function validLspRange(range) {
    if (!isObjectValue(range) || !validLspPosition(range["start"]) ||
        !validLspPosition(range["end"])) return false;
    const first = range["start"];
    const last = range["end"];
    return first["line"] < last["line"] ||
        (first["line"] === last["line"] && first["character"] <= last["character"]);
}

function validateRequestId(id) {
    if (id === null) return true;
    if (typeof id === "String") return true;
    if (typeof id === "Number" && id.isInteger) return true;
    return false;
}

// Returns true only when an 'exit' notification requires process termination.
export function handleMessage(state, request) {
    // JSON.parse creates object-origin Maps that expose typeof "Object".
    const requestType = typeof request;
    if (request === null || (requestType !== "Object" && requestType !== "Map")) {
        respondError(null, -32600, "Invalid Request");
        return false;
    }
    if (request["jsonrpc"] !== "2.0" || typeof request["method"] !== "String") {
        respondError(null, -32600, "Invalid Request");
        return false;
    }

    const hasId = request.has("id");
    const id = request["id"];
    if (hasId && !validateRequestId(id)) {
        respondError(null, -32600, "Invalid request id");
        return false;
    }
    const method = request["method"];

    if (method === "exit") return true;

    if (method === "initialize") {
        if (!hasId) return false;
        if (state["initialized"]) {
            respondError(id, -32600, "Server already initialized");
            return false;
        }
        initializeWorkspace(state, request["params"]);
        state["initialized"] = true;
        respond(id, {
            capabilities: {
                positionEncoding: "utf-16",
                textDocumentSync: {openClose: true, change: 2},
                definitionProvider: true,
                referencesProvider: true,
                documentSymbolProvider: true,
                hoverProvider: true,
                completionProvider: {resolveProvider: false, triggerCharacters: [".", "?"]},
                signatureHelpProvider: {triggerCharacters: ["(", ","], retriggerCharacters: [","]},
                renameProvider: {prepareProvider: true},
                semanticTokensProvider: {
                    legend: {tokenTypes: SEMANTIC_TOKEN_TYPES, tokenModifiers: SEMANTIC_TOKEN_MODIFIERS},
                    full: true, range: true
                }
            },
            serverInfo: {name: "napalm-lsp", version: "0.1.0"}
        });
        return false;
    }

    if (!state["initialized"]) {
        if (hasId) respondError(id, -32002, "Server not initialized");
        return false;
    }

    if (method === "shutdown") {
        if (!hasId) return false;
        state["shutdown"] = true;
        respond(id, null);
        return false;
    }
    if (state["shutdown"]) {
        if (hasId) respondError(id, -32600, "Server is shutting down");
        return false;
    }

    if (method === "initialized") return false;
    if (method === "$/cancelRequest" || method === "$/setTrace") return false;

    if (method === "textDocument/definition" ||
        method === "textDocument/references" ||
        method === "textDocument/documentSymbol" ||
        method === "textDocument/hover" ||
        method === "textDocument/completion" ||
        method === "textDocument/signatureHelp" ||
        method === "textDocument/prepareRename" ||
        method === "textDocument/rename" ||
        method === "textDocument/semanticTokens/full" ||
        method === "textDocument/semanticTokens/range") {
        if (!hasId) return false;
        const params = request["params"];
        const document = !isObjectValue(params) ? null : params["textDocument"];
        const uri = !isObjectValue(document) ? null : document["uri"];
        if (typeof uri !== "String" || getDocument(state["documents"], uri) === null) {
            respondError(id, -32602, "Document is not open");
            return false;
        }
        const cached = state["analyses"].get(uri);
        if (cached === null) {
            respondError(id, -32603, "Document analysis is unavailable");
            return false;
        }
        const semantic = cached["result"];
        if (method === "textDocument/documentSymbol") {
            respond(id, semantic["documentSymbols"]);
            return false;
        }
        if (method === "textDocument/semanticTokens/full" ||
            method === "textDocument/semanticTokens/range") {
            const range = method === "textDocument/semanticTokens/range" ? params["range"] : null;
            if (method === "textDocument/semanticTokens/range" && !validLspRange(range)) {
                respondError(id, -32602, "Invalid semantic token range");
                return false;
            }
            respond(id, semanticTokensAt(state["moduleIndex"], uri, range));
            return false;
        }
        const position = params["position"];
        if (!validLspPosition(position)) {
            respondError(id, -32602, "Invalid document position");
            return false;
        }
        if (method === "textDocument/hover") {
            respond(id, hoverAt(state["moduleIndex"], uri, position));
            return false;
        }
        if (method === "textDocument/completion") {
            respond(id, completionAt(state["moduleIndex"], uri, position));
            return false;
        }
        if (method === "textDocument/signatureHelp") {
            respond(id, signatureHelpAt(state["moduleIndex"], uri, position));
            return false;
        }
        if (method === "textDocument/prepareRename") {
            respond(id, prepareRenameAt(state["moduleIndex"], uri, position));
            return false;
        }
        if (method === "textDocument/rename") {
            const newName = params["newName"];
            if (typeof newName !== "String") {
                respondError(id, -32602, "Invalid new symbol name");
            } else respond(id, renameAt(state["moduleIndex"], uri, position, newName));
            return false;
        }
        if (method === "textDocument/definition") {
            respond(id, moduleDefinitionAt(state["moduleIndex"], uri, position));
            return false;
        }
        const context = params["context"];
        const includeDeclaration = isObjectValue(context) && context["includeDeclaration"] === true;
        respond(id, moduleReferencesAt(state["moduleIndex"], uri, position, includeDeclaration));
        return false;
    }

    if (method === "workspace/didChangeWatchedFiles") {
        const dirtyPaths = [];
        const params = request["params"];
        const changes = isObjectValue(params) ? params["changes"] : null;
        if (changes !== null) {
            for (const change of changes) {
                if (!isObjectValue(change)) continue;
                const path = filePathForUri(change["uri"]);
                if (path !== null) dirtyPaths.push(path);
            }
        }
        if (dirtyPaths.length === 0 && state["moduleIndex"] !== null) {
            // An unspecified watcher event may affect any cached disk source.
            for (const record of state["moduleIndex"].order) {
                if (!state["documents"].has(record.uri)) dirtyPaths.push(record.path);
            }
        }
        refreshModules(state, dirtyPaths);
        if (hasId) respond(id, null);
        return false;
    }

    if (method === "textDocument/didOpen" ||
        method === "textDocument/didChange" ||
        method === "textDocument/didClose") {
        const params = request["params"];
        if (params === null) {
            if (hasId) respondError(id, -32602, "Missing document notification params");
            else logError("Ignoring document notification without params");
            return false;
        }
        try {
            if (method === "textDocument/didOpen") {
                openDocument(state["documents"], params);
            } else if (method === "textDocument/didChange") {
                changeDocument(state["documents"], params);
            } else {
                closeDocument(state["documents"], params);
            }
            const uri = params["textDocument"]["uri"];
            if (method === "textDocument/didClose") {
                state["analyses"].delete(uri);
                clearLexicalDiagnostics(uri);
            }
            const dirtyPath = filePathForUri(uri);
            refreshModules(state, dirtyPath === null ? [] : [dirtyPath]);
            if (hasId) respond(id, null);
        } catch (error) {
            if (hasId) respondError(id, -32602, "Invalid document notification params");
            else logError("Failed to process " + method + ": " + `${error}`);
        }
        return false;
    }

    if (hasId) respondError(id, -32601, "Method not found: " + method);
    return false;
}
